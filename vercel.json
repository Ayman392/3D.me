{
    "services": {
        "client": {
            "root": "client",
            "framework": "nextjs"
        },
        "server": {
            "root": "server",
            "framework": "express"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "server"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "client"
            }
        }
    ]
}